# -----------------------------------------------------------------------------
# LaunchPad Platform - Docker Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env and adjust variables as needed:
# cp docker/.env.example docker/.env

# PostgreSQL Configuration
POSTGRES_USER=launchpad_user
POSTGRES_PASSWORD=launchpad_password
POSTGRES_DB=launchpad_db
POSTGRES_PORT=5432

# Application Security
SECRET_KEY=launchpad-super-secret-dev-key-change-in-production-only
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
