# Application Configuration
PROJECT_NAME="LaunchPad Task Manager API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Security & Tokens
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="launchpad-super-secret-dev-key-change-in-production-only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="launchpad_user"
POSTGRES_PASSWORD="launchpad_password"
POSTGRES_DB="launchpad_db"
# Optional explicit override:
# DATABASE_URL="postgresql://launchpad_user:launchpad_password@localhost:5432/launchpad_db"

# CORS Configuration (JSON array string)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://localhost:8080"]'
