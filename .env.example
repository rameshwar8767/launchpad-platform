# LaunchPad Platform - Docker Compose Environment Template
# Copy this file to .env before running: docker compose up --build

# PostgreSQL Database Configuration
POSTGRES_USER=launchpad_user
POSTGRES_PASSWORD=launchpad_password
POSTGRES_DB=launchpad_db
POSTGRES_PORT=5432

# Backend Security Configuration
# Generate a production key with: openssl rand -hex 32
SECRET_KEY=launchpad-super-secret-dev-key-change-in-production-only
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
